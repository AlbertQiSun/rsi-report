---
import Base from '../layouts/Base.astro';
// Evidence search: no LLM. The index (public/search-index.json) is built from every published text file by
// report/tools/build_search_index.py; ranking is BM25 in the browser; every hit links to the exact lines on GitHub.
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
const REPO = (import.meta.env.PUBLIC_REPO_URL || '').replace(/\/$/, '');
const BRANCH = import.meta.env.PUBLIC_REPO_BRANCH || 'main';
---
<Base title="证据检索 · Evidence search" description="在报告、日志、数据和代码里检索原文证据">
  <header class="global-header">
    <div class="global-header-inner">
      <a class="brand" href={`${BASE}/`}>RSI Report</a>
      <nav class="global-nav" aria-label="Primary">
        <a href={`${BASE}/`}><span data-l="zh">返回报告</span><span data-l="en">Back to report</span></a>
      </nav>
      <div class="lang" role="group" aria-label="Language">
        <button type="button" data-set-lang="zh" aria-pressed="true">中文</button>
        <button type="button" data-set-lang="en" aria-pressed="false">English</button>
      </div>
    </div>
  </header>

  <main class="sx" data-base={BASE} data-repo={REPO} data-branch={BRANCH}>
    <h1><span data-l="zh">证据检索</span><span data-l="en">Evidence search</span></h1>
    <p class="sx-lead">
      <span data-l="zh">输入一个问题或关键词，页面会在本报告公开的全部材料里（各节正文、实验日志、比较数据、平台代码）找出最相关的原文片段。这里不生成回答，只展示原文；每个片段都链接到 GitHub 上对应文件的具体行。</span>
      <span data-l="en">Type a question or keywords. The page finds the most relevant original passages across everything this report publishes (section text, experiment logs, comparison data, platform code). It does not generate answers; it shows the source text, and every passage links to the exact lines of the file on GitHub.</span>
    </p>
    <form class="sx-form" autocomplete="off">
      <input id="sx-q" type="search" placeholder="例如：第三轮为什么变差 / why did round 3 get worse / lora_train time limit" aria-label="Search" />
      <button type="submit"><span data-l="zh">检索</span><span data-l="en">Search</span></button>
    </form>
    <div class="sx-filters" role="group" aria-label="Filter">
      <label><input type="checkbox" value="report" checked /> <span data-l="zh">报告正文</span><span data-l="en">Report</span></label>
      <label><input type="checkbox" value="log" checked /> <span data-l="zh">日志</span><span data-l="en">Logs</span></label>
      <label><input type="checkbox" value="data" checked /> <span data-l="zh">数据</span><span data-l="en">Data</span></label>
      <label><input type="checkbox" value="doc" checked /> <span data-l="zh">研究文档</span><span data-l="en">Research notes</span></label>
      <label><input type="checkbox" value="code" checked /> <span data-l="zh">代码</span><span data-l="en">Code</span></label>
    </div>
    <p class="sx-status" id="sx-status"><span data-l="zh">正在载入索引……</span><span data-l="en">Loading index…</span></p>
    <ol class="sx-results" id="sx-results"></ol>
  </main>

  <style>
    .sx { max-width: 920px; margin: 0 auto; padding: 96px 16px 64px; }
    .sx h1 { font-size: var(--type-title); margin: 0 0 12px; }
    .sx-lead { color: var(--muted); line-height: 1.7; margin: 0 0 20px; }
    .sx-form { display: flex; gap: 8px; }
    .sx-form input { flex: 1; min-width: 0; font: inherit; font-size: 16px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); color: var(--text); }
    .sx-form button { font: inherit; padding: 10px 16px; border: 0; border-radius: 8px; background: var(--accent); color: #fff; cursor: pointer; }
    .sx-filters { display: flex; flex-wrap: wrap; gap: 12px; margin: 12px 0 8px; color: var(--muted); font-size: 14px; }
    .sx-status { color: var(--faint); font-size: 14px; margin: 8px 0 16px; }
    .sx-results { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
    .sx-hit { background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
    .sx-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; font-size: 13px; margin-bottom: 8px; }
    .sx-kind { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; padding: 1px 6px; border-radius: 4px; background: var(--accent-soft); color: var(--accent); }
    .sx-meta a { font-family: var(--mono); word-break: break-all; }
    .sx-hit pre { margin: 0; font-family: var(--mono); font-size: 12.5px; line-height: 1.55; white-space: pre-wrap; word-break: break-word; max-height: 22em; overflow: auto; color: var(--text); }
    .sx-hit mark { background: #fde9a8; color: inherit; border-radius: 2px; }
    .sx-ln { color: var(--faint); user-select: none; }
  </style>

  <script is:inline>
    (function () {
      const main = document.querySelector('.sx');
      const BASE = main.dataset.base, REPO = main.dataset.repo, BRANCH = main.dataset.branch;
      const status = document.getElementById('sx-status');
      const list = document.getElementById('sx-results');
      const input = document.getElementById('sx-q');
      const zh = () => document.documentElement.dataset.lang !== 'en';
      let IDX = null, DOCS = null, DF = null, AVG = 0;

      // tokens: latin words / numbers (and code identifiers split on _ . -), plus CJK unigrams and bigrams
      function tokens(s) {
        s = s.toLowerCase();
        const out = [];
        for (const m of s.matchAll(/[a-z0-9]+(?:[._-][a-z0-9]+)*/g)) {
          out.push(m[0]);
          const parts = m[0].split(/[._-]/);
          if (parts.length > 1) out.push(...parts.filter((p) => p.length > 1));
        }
        for (const run of s.matchAll(/[㐀-鿿]+/g)) {
          const r = run[0];
          for (let i = 0; i < r.length; i++) {
            out.push(r[i]);
            if (i + 1 < r.length) out.push(r.slice(i, i + 2));
          }
        }
        return out;
      }

      function build() {
        DOCS = IDX.chunks.map((c) => {
          const tf = new Map();
          const toks = tokens(c[4] + ' ' + IDX.files[c[0]]);
          for (const t of toks) tf.set(t, (tf.get(t) || 0) + 1);
          return { c, tf, len: toks.length };
        });
        DF = new Map();
        let total = 0;
        for (const d of DOCS) { total += d.len; for (const t of d.tf.keys()) DF.set(t, (DF.get(t) || 0) + 1); }
        AVG = total / DOCS.length;
      }

      function search(q) {
        const qt = [...new Set(tokens(q))];
        const kinds = new Set([...document.querySelectorAll('.sx-filters input:checked')].map((i) => i.value));
        const N = DOCS.length, k1 = 1.2, b = 0.75;
        const scored = [];
        for (const d of DOCS) {
          if (!kinds.has(d.c[3])) continue;
          let s = 0;
          for (const t of qt) {
            const f = d.tf.get(t);
            if (!f) continue;
            const df = DF.get(t);
            const idf = Math.log(1 + (N - df + 0.5) / (df + 0.5));
            s += idf * (f * (k1 + 1)) / (f + k1 * (1 - b + b * d.len / AVG));
          }
          if (s > 0) scored.push([s, d]);
        }
        scored.sort((a, b) => b[0] - a[0]);
        return { qt, hits: scored.slice(0, 12) };
      }

      const esc = (s) => s.replace(/[&<>]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[ch]));

      function highlight(line, qt) {
        let h = esc(line);
        const words = qt.filter((t) => t.length > 1 || /[㐀-鿿]/.test(t)).sort((a, b) => b.length - a.length);
        if (!words.length) return h;
        const re = new RegExp('(' + words.map((w) => w.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|') + ')', 'gi');
        return h.replace(re, '<mark>$1</mark>');
      }

      function render(q) {
        if (!IDX) return;
        list.innerHTML = '';
        if (!q.trim()) { status.textContent = zh() ? '输入问题或关键词开始检索。' : 'Type a question or keywords.'; return; }
        const { qt, hits } = search(q);
        status.textContent = hits.length
          ? (zh() ? `找到 ${hits.length} 个最相关的片段（按相关度排序）。` : `Top ${hits.length} passages, ranked by relevance.`)
          : (zh() ? '没有找到匹配的片段，换个说法或关键词试试。' : 'No matching passages; try other words.');
        for (const [, d] of hits) {
          const [fi, s, e, kind, text] = d.c;
          const path = IDX.files[fi];
          const url = REPO ? `${REPO}/blob/${BRANCH}/${encodeURI(path)}#L${s}-L${e}` : null;
          const lines = text.split('\n');
          const li = document.createElement('li');
          li.className = 'sx-hit';
          const kindLabel = { report: zh() ? '报告' : 'report', log: zh() ? '日志' : 'log', data: zh() ? '数据' : 'data', doc: zh() ? '文档' : 'notes', code: zh() ? '代码' : 'code' }[kind] || kind;
          const where = `${path}:${s}–${e}`;
          li.innerHTML = `<div class="sx-meta"><span class="sx-kind">${kindLabel}</span>` +
            (url ? `<a href="${url}" target="_blank" rel="noopener">${esc(where)}</a>` : `<span>${esc(where)}</span>`) + `</div>` +
            `<pre>${lines.map((l, i) => `<span class="sx-ln">${String(s + i).padStart(4, ' ')}  </span>${highlight(l, qt)}`).join('\n')}</pre>`;
          list.appendChild(li);
        }
      }

      fetch(`${BASE}/search-index.json`).then((r) => r.json()).then((j) => {
        IDX = j; build();
        status.textContent = zh() ? `索引已载入：${IDX.files.length} 个文件、${IDX.chunks.length} 个片段。` : `Index loaded: ${IDX.files.length} files, ${IDX.chunks.length} passages.`;
        const q0 = new URLSearchParams(location.search).get('q');
        if (q0) { input.value = q0; render(q0); }
      }).catch(() => { status.textContent = zh() ? '索引载入失败。' : 'Failed to load the index.'; });

      document.querySelector('.sx-form').addEventListener('submit', (ev) => {
        ev.preventDefault();
        const q = input.value;
        history.replaceState(null, '', q ? `?q=${encodeURIComponent(q)}` : location.pathname);
        render(q);
      });
      document.querySelectorAll('.sx-filters input').forEach((el) => el.addEventListener('change', () => render(input.value)));
    })();
  </script>
</Base>
