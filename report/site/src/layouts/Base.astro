---
import '../styles/global.css';
const { title = 'RSI 调研报告', description = '' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN" data-lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&family=Noto+Sans+SC:wght@400;500;600&family=Fragment+Mono&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const saved = localStorage.getItem('rsi-lang');
        if (saved === 'en' || saved === 'zh') document.documentElement.dataset.lang = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        const root = document.documentElement;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const finePointer = window.matchMedia('(pointer: fine)').matches;

        /* ---- language switch ---- */
        function apply(lang) {
          root.dataset.lang = lang;
          root.lang = lang === 'en' ? 'en' : 'zh-CN';
          document.querySelectorAll('[data-set-lang]').forEach((b) =>
            b.setAttribute('aria-pressed', String(b.dataset.setLang === lang)));
          try { localStorage.setItem('rsi-lang', lang); } catch (e) {}
        }
        document.querySelectorAll('[data-set-lang]').forEach((b) =>
          b.addEventListener('click', () => apply(b.dataset.setLang)));
        apply(root.dataset.lang || 'zh');

        /* ---- page TOC: highlight the section in view ---- */
        const links = new Map();
        document.querySelectorAll('.page-toc a[href^="#"]').forEach((a) => links.set(a.getAttribute('href').slice(1), a));
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting && links.has(e.target.id)) {
              links.forEach((a) => a.classList.remove('active'));
              links.get(e.target.id).classList.add('active');
            }
          });
        }, { rootMargin: '-30% 0px -60% 0px' });
        document.querySelectorAll('.doc-section[id]').forEach((s) => io.observe(s));

        /* ---- page TOC appears once the hero has scrolled away ---- */
        const toc = document.querySelector('.page-toc');
        const heroEl = document.querySelector('.hero');
        if (toc && heroEl) new IntersectionObserver(([e]) => toc.classList.toggle('shown', !e.isIntersecting), { rootMargin: '-120px 0px 0px 0px' }).observe(heroEl);

        /* ---- reading progress bar ---- */
        const bar = document.querySelector('.progress');
        function progress() {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          bar && bar.style.setProperty('--p', String(max > 0 ? Math.min(1, window.scrollY / max) : 0));
        }
        window.addEventListener('scroll', progress, { passive: true });
        progress();

        /* ---- scroll reveal ---- */
        const rev = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); rev.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.reveal').forEach((el) => (reduce ? el.classList.add('in') : rev.observe(el)));

        /* ---- replay videos play only while on screen ---- */
        const vio = new IntersectionObserver((entries) => {
          entries.forEach((e) => { const v = e.target; if (e.isIntersecting) { v.play().catch(() => {}); } else { v.pause(); } });
        }, { threshold: 0.35 });
        if (!reduce) document.querySelectorAll('video[data-autoplay]').forEach((v) => vio.observe(v));

        /* ---- card spotlight follows the pointer ---- */
        document.querySelectorAll('.card').forEach((c) => {
          c.addEventListener('pointermove', (ev) => {
            const r = c.getBoundingClientRect();
            c.style.setProperty('--mx', `${ev.clientX - r.left}px`);
            c.style.setProperty('--my', `${ev.clientY - r.top}px`);
          });
        });

        /* ---- footnote preview popover ---- */
        const pop = document.createElement('div');
        pop.className = 'fn-pop';
        pop.setAttribute('role', 'tooltip');
        document.body.appendChild(pop);
        let hideT;
        function showFn(a) {
          const li = document.querySelector(a.getAttribute('href'));
          if (!li) return;
          const body = li.querySelector(`[data-l="${root.dataset.lang}"]`) || li;
          const meta = li.dataset.pop;
          pop.innerHTML = '';
          const t = document.createElement('div'); t.textContent = `${li.querySelector('.n').textContent}. ${body.textContent}`;
          pop.appendChild(t);
          if (meta) { const m = document.createElement('div'); m.className = 'meta'; m.textContent = meta; pop.appendChild(m); }
          const r = a.getBoundingClientRect();
          const w = Math.min(360, window.innerWidth - 32);
          pop.style.maxWidth = `${w}px`;
          const left = Math.max(16, Math.min(window.scrollX + r.left - 20, window.scrollX + window.innerWidth - w - 16));
          pop.style.left = `${left}px`;
          pop.style.top = `${window.scrollY + r.bottom + 8}px`;
          clearTimeout(hideT); pop.classList.add('show');
        }
        function hideFn() { hideT = setTimeout(() => pop.classList.remove('show'), 80); }
        document.querySelectorAll('sup.fn a').forEach((a) => {
          a.addEventListener('mouseenter', () => showFn(a));
          a.addEventListener('focus', () => showFn(a));
          a.addEventListener('mouseleave', hideFn);
          a.addEventListener('blur', hideFn);
        });

        /* ---- references: filter chips, expand / collapse all, open the entry a footnote points to ---- */
        const refList = document.querySelector('ol.refs');
        if (refList) {
          const items = [...refList.querySelectorAll('li')];
          document.querySelectorAll('.refs-chip').forEach((chip) => chip.addEventListener('click', () => {
            document.querySelectorAll('.refs-chip').forEach((c) => c.classList.toggle('on', c === chip));
            const g = chip.dataset.group;
            items.forEach((li) => { li.hidden = g !== 'all' && li.dataset.group !== g; });
          }));
          const tog = document.querySelector('.refs-toggle');
          tog?.addEventListener('click', () => {
            const open = tog.dataset.open !== '1';
            tog.dataset.open = open ? '1' : '0';
            items.forEach((li) => { if (!li.hidden) li.querySelector('details').open = open; });
          });
          const openTarget = () => {
            const m = location.hash.match(/^#ref-\d+$/);
            if (!m) return;
            const li = document.querySelector(location.hash);
            if (!li) return;
            if (li.hidden) document.querySelector('.refs-chip[data-group="all"]')?.click();
            li.querySelector('details').open = true;
            requestAnimationFrame(() => li.scrollIntoView({ block: 'center' }));
            li.classList.add('flash'); setTimeout(() => li.classList.remove('flash'), 1600);
          };
          window.addEventListener('hashchange', openTarget);
          openTarget();
        }

        /* ---- chart hover card: replaces the slow native <title> tooltip ---- */
        const tipEl = document.createElement('div');
        tipEl.className = 'chart-tip';
        tipEl.setAttribute('role', 'tooltip');
        document.body.appendChild(tipEl);
        document.querySelectorAll('.svg-wrap svg').forEach((svg) => {
          svg.querySelectorAll('title').forEach((t) => {
            const mark = t.parentElement;
            mark.dataset.tip = t.textContent;
            mark.classList.add('has-tip');
            mark.setAttribute('tabindex', '0');
            t.remove();                                   // no double tooltip
          });
        });
        function placeTip(x, y) {
          const pad = 14, w = tipEl.offsetWidth, h = tipEl.offsetHeight;
          let left = x + pad, top = y + pad;
          if (left + w > window.innerWidth - 8) left = x - w - pad;
          if (top + h > window.innerHeight - 8) top = y - h - pad;
          tipEl.style.transform = `translate(${Math.max(8, left)}px, ${Math.max(8, top)}px)`;
        }
        function showTip(el, x, y) {
          const raw = el.dataset.tip || '';
          const m = raw.match(/^(.*?)(\s*\[[^\]]+\]\s*)?$/);
          tipEl.innerHTML = '';
          const main = document.createElement('div'); main.textContent = (m && m[1]) || raw; tipEl.appendChild(main);
          if (m && m[2]) { const src = document.createElement('div'); src.className = 'chart-tip-src'; src.textContent = m[2].trim(); tipEl.appendChild(src); }
          tipEl.classList.add('show');
          placeTip(x, y);
        }
        function hideTip() { tipEl.classList.remove('show'); }
        document.querySelectorAll('.has-tip').forEach((el) => {
          el.addEventListener('pointerenter', (e) => showTip(el, e.clientX, e.clientY));
          el.addEventListener('pointermove', (e) => placeTip(e.clientX, e.clientY));
          el.addEventListener('pointerleave', hideTip);
          el.addEventListener('focus', () => { const r = el.getBoundingClientRect(); showTip(el, r.right, r.top); });
          el.addEventListener('blur', hideTip);
        });
        window.addEventListener('scroll', hideTip, { passive: true });

        /* ---- click-to-enlarge figures (lightbox) ---- */
        const lb = document.createElement('div');
        lb.className = 'lightbox'; lb.setAttribute('role', 'dialog'); lb.setAttribute('aria-modal', 'true');
        lb.innerHTML = '<img alt="" />';
        document.body.appendChild(lb);
        const lbImg = lb.querySelector('img');
        function closeLb() { lb.classList.remove('open'); }
        document.querySelectorAll('img[data-zoom]').forEach((img) => {
          img.addEventListener('click', () => { lbImg.src = img.currentSrc || img.src; lbImg.alt = img.alt; lb.classList.add('open'); });
        });
        lb.addEventListener('click', closeLb);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLb(); });

        /* ---- soft pastel glow in the hero follows the pointer ---- */
        const hero = document.querySelector('.hero');
        if (hero && finePointer && !reduce) {
          let tx = 70, ty = 20, cx = 70, cy = 20, raf = 0;
          function step() {
            cx += (tx - cx) * 0.08; cy += (ty - cy) * 0.08;
            hero.style.setProperty('--gx', cx.toFixed(2) + '%');
            hero.style.setProperty('--gy', cy.toFixed(2) + '%');
            raf = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.05 ? requestAnimationFrame(step) : 0;
          }
          hero.addEventListener('pointermove', (e) => {
            const r = hero.getBoundingClientRect();
            tx = ((e.clientX - r.left) / r.width) * 100; ty = ((e.clientY - r.top) / r.height) * 100;
            if (!raf) raf = requestAnimationFrame(step);
          });
        }
      })();
    </script>
  </body>
</html>
